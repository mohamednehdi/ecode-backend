# Copy this file to .env and fill in the values. Never commit .env.

# Generate each key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_EXPIRES_MINUTES=30

DATABASE_URL=mysql+pymysql://root:@localhost/barcodedb

FRONTEND_ORIGIN=http://localhost:4200
MAX_UPLOAD_MB=10
PDF_DPI=200
PDF_MAX_PAGES=20
# Free public upload page: requests allowed per IP
PUBLIC_RATE_LIMIT=10 per minute;60 per hour

# Gmail: use an App Password (Google account > Security > App passwords)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreplyybarcode@gmail.com
SMTP_PASSWORD=

# Production server (python serve.py)
WAITRESS_THREADS=8
DB_POOL_SIZE=20
# Rate-limit counters: memory:// works for one process; use redis://localhost:6379 with several processes/servers
RATELIMIT_STORAGE_URI=memory://
# Decoding
DECODE_MAX_SIDE=3000
DECODE_FALLBACK_BUDGET_MS=2000

# Redis (optional): shared quota and rate-limit counters for several workers/servers. Empty = no Redis.
REDIS_URL=
# Number of reverse proxies in front of the app (1 behind Nginx, 0 when reached directly)
TRUSTED_PROXIES=0

# Docker (docker compose up): password of the MySQL container (letters and digits only)
MYSQL_ROOT_PASSWORD=change-me
# WEB_WORKERS=2   WEB_THREADS=4   APP_REPLICAS=2   HTTP_PORT=8080

# 1 = debug mode (development only)
FLASK_DEBUG=1
