# Copy this file to .env and fill in the values. Never commit .env.

# Generate each key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_EXPIRES_MINUTES=30

DATABASE_URL=mysql+pymysql://root:@localhost/barcodedb

FRONTEND_ORIGIN=http://localhost:4200
MAX_UPLOAD_MB=10
PDF_DPI=200
PDF_MAX_PAGES=20

# Gmail: use an App Password (Google account > Security > App passwords)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreplyybarcode@gmail.com
SMTP_PASSWORD=

# 1 = debug mode (development only)
FLASK_DEBUG=1
